cabal-version: 3.0
name:          hydra-registry-api
version:       0.1.0.0
synopsis:      REST API for querying Hydra L2 UTxO state
license:       Apache-2.0
author:        Sasa Bogicevic
build-type:    Simple

common shared
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DerivingVia
    DataKinds
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
  ghc-options:
    -Wall
    -Werror

library
  import: shared
  hs-source-dirs: src
  exposed-modules:
    Api
    Api.Types
    Api.Validation
    Cache
    Config
    Blockfrost
    Db
    Db.Schema
    Explorer.Client
    Explorer.Members
    Explorer.Sidecar
    Hydra.Client
    Hydra.Htlc
    Indexer
    L1.HeadScan
    L1.HtlcScan
    Logging
    Metrics
    Middleware.RateLimit
    Relay.EventBus
    Relay.ExpirySweep
    Relay.Graph
    Relay.HtlcWatcher
    Relay.Slot
    Tx.Builder
  build-depends:
    , base >= 4.18 && < 5
    , aeson
    , async
    , base16-bytestring
    , bech32
    , bytestring
    , cardano-api
    , cborg
    , containers
    , crypton
    , filepath
    , hasql
    , hasql-pool
    , http-client
    , http-client-tls
    , http-types
    , hydra-cardano-api
    , hydra-node
    , mtl
    , network-uri
    , process
    , rel8
    , servant
    , servant-server
    , stm
    , text
    , time
    , uuid
    , wai
    , vector
    , wai-cors
    , wai-extra
    , warp
    , websockets
    , wuss

executable hydra-registry-api
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    "-with-rtsopts=-N"
  build-depends:
    , base >= 4.18 && < 5
    , aeson
    , async
    , hydra-registry-api
    , servant-server
    , stm
    , unix
    , wai-extra
    , warp

test-suite hydra-registry-api-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-tool-depends:
    hspec-discover:hspec-discover
  ghc-options:
    -threaded
    -rtsopts
    "-with-rtsopts=-N"
  build-depends:
    , base >= 4.18 && < 5
    , aeson
    , base16-bytestring
    , bech32
    , bytestring
    , cardano-ledger-alonzo
    , cborg
    , containers
    , hasql-pool
    , hspec
    , hspec-wai
    , http-types
    , hydra-cardano-api
    , hydra-registry-api
    , QuickCheck
    , servant-server
    , stm
    , text
    , time
    , hasql
    , vector
    , wai
    , wai-extra
  other-modules:
    IndexerSpec
    AgentPushSpec
    ApiIntegrationSpec
    ApiTypesSpec
    ConfigSpec
    L1HeadScanSpec
    L1HtlcScanSpec
    DbIntegrationSpec
    ExplorerClientSpec
    HydraClientSpec
    ApiSpec
    HydraHtlcSpec
    RateLimitSpec
    RelayEventBusSpec
    RelayGraphSpec
    RelayHtlcWatcherSpec
    RelaySlotSpec
    SidecarSpec
    TestUtils
    TxBuilderSpec
    ValidationSpec
