packages:
  .

-- Hydra libraries pinned to a hydra master rev (2026-08-03) — the same
-- rev the flake's hydra input locks. Never a local checkout. Bump the
-- rev together with `nix flake update hydra`, and keep index-state,
-- allow-newer and constraints below mirroring hydra's cabal.project at
-- that rev so the external cardano-api/ledger/plutus tree resolves to
-- the same store hashes as a hydra build and is reused, not recompiled.
source-repository-package
  type: git
  location: https://github.com/cardano-scaling/hydra
  tag: 7b169d66d6bdc35662723933785f4d7624d49605
  subdir:
    hydra-prelude
    hydra-cardano-api
    hydra-plutus
    hydra-plutus-extras
    hydra-tx
    hydra-node
    hydra-test-utils

write-ghc-environment-files: never

-- Build tests of local packages by default (the per-package stanzas
-- below still turn them off for the upstream hydra packages), so
-- `cabal test` reuses the same solve as `cabal build`.
tests: True
test-show-details: direct

allow-newer:
  servant-multipart-client:random,
  cardano-api:plutus-core,
  cardano-api:plutus-ledger-api,
  cardano-api:plutus-tx,
  cardano-ledger-api:plutus-ledger-api,
  cardano-ledger-alonzo:plutus-ledger-api,
  cardano-ledger-alonzo:plutus-core,
  cardano-ledger-babbage:plutus-ledger-api,
  cardano-ledger-conway:plutus-ledger-api,
  cardano-ledger-mary:plutus-ledger-api,
  cardano-ledger-shelley:plutus-ledger-api

constraints:
  plutus-core == 1.63.0.0,
  plutus-tx == 1.63.0.0,
  plutus-tx-plugin == 1.63.0.0,
  plutus-ledger-api == 1.63.0.0,
  plutus-metatheory == 1.63.0.0

-- Same stanza as hydra's own cabal.project (parallelism + identical
-- external-dependency store hashes).
package *
  ghc-options: -j8

-- Do not build tests or benchmarks for the upstream hydra packages.
package hydra-prelude
  tests: False
  benchmarks: False

package hydra-cardano-api
  tests: False
  benchmarks: False

package hydra-plutus
  tests: False
  benchmarks: False

package hydra-plutus-extras
  tests: False
  benchmarks: False

package hydra-tx
  tests: False
  benchmarks: False

package hydra-node
  tests: False
  benchmarks: False

package hydra-test-utils
  tests: False
  benchmarks: False
